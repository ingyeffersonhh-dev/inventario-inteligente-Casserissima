API_HOST=0.0.0.0
API_PORT=8000

# Base de datos SQLite (ruta relativa al directorio backend/)
DATABASE_URL=sqlite:///./casserisissima.db

# Configuración del motor predictivo
FORECAST_HORIZON_DAYS=14
MIN_HISTORY_DAYS=21
SERVICE_LEVEL_TARGET=0.97

ENVIRONMENT=development
