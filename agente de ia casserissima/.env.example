# Gemini API Key (necesaria para el LLM principal)
GEMINI_API_KEY=""

# Telegram Bot Token (obtenido de @BotFather en Telegram)
TELEGRAM_BOT_TOKEN=""

# IDs de Chat permitidos (separados por coma). Vacio = permitir todos.
AUTHORIZED_CHAT_IDS=""

# Acceso abierto: si true, cualquiera con el QR del bot puede hablar con el
OPEN_ACCESS=true

# Las rutas (MAIN_SYSTEM_PATH y DB_PATH) se calculan automaticamente
# relativas al repositorio. No las agregues a menos que muevas la estructura.